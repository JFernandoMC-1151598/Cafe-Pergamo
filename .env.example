# Copia este archivo y renómbralo a `.env`.
# Luego completa los valores con las credenciales que te proporcionen en Supabase.
# El archivo `.env` ya se encuentra protegido en .gitignore.

# --- Django ---
SECRET_KEY=django-insecure-t^h&eks)^po0t!tfm^!(t_8e0f2^k%3xi-zl)v182qa1+^q2rr
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# BASE DE DATOS SUPABASE (PostgreSQL)
# ==============================================================================
# En Supabase ve a: Project Settings -> Database -> Connection string
# 
# OPCIÓN 1 (Recomendada): Usar la URL directa o de Pooler (URI)
# Ejemplo:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# OPCIÓN 2 (Alternativa con parámetros individuales):
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_HOST=db.[PROJECT_REF].supabase.co
# DB_PORT=5432
# DB_SSLMODE=require

# ==============================================================================
# SUPABASE AUTH / API (usuarios/supabase_client.py)
# ==============================================================================
# La autenticación real (registro, login, recuperación de contraseña) la
# resuelve Supabase Auth, no Django. Estos dos valores son la URL del
# proyecto y la publishable/anon key — se obtienen en Supabase:
# Project Settings -> API. Son seguros de exponer en el backend (la
# protección real la da Row Level Security); NUNCA pongas aquí la
# service_role key.
SUPABASE_URL=https://ejlflriypoiiygvuklkk.supabase.co
SUPABASE_ANON_KEY=sb_publishable_wivjO99J1_TtM5Z6yB2KXw_YpSuByoe
